# MuzTalk Environment Configuration
# ==============================================================================
# STRICT DATABASE RULE: MySQL 8.0+ is the ONLY primary production database.
# Architecture: Android Mobile App + Web Admin Panel (No Redis required).
# All integrations (SMTP, MySQL, Twilio, Firebase, Calls, Domains) can also be
# configured directly from the Web Admin Panel -> Integrations & DB.
# ==============================================================================

# MySQL 8 Connection (InnoDB, utf8mb4_unicode_ci)
# Use either DATABASE_URL (URL-encode special chars like ! as %21) OR individual MYSQL_* fields:
DATABASE_URL=""
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_DATABASE=""
MYSQL_USER=""
MYSQL_PASSWORD=""

# Server & Public Domains
PORT=3000
NODE_ENV="production"
APP_URL="https://apimuzatalk.rrgindustry.com"
FRONTEND_URL="https://apimuzatalk.rrgindustry.com/"
BACKEND_API_URL="https://apimuzatalk.rrgindustry.com/"
DEV_OTP_MODE="false"
MUZTALK_DATA_DIR=""

# Auth secrets (REQUIRED in production). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, random secrets are created on every restart and ALL users get logged out.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ADMIN_JWT_SECRET=""
MEDIA_SIGN_KEY=""

# Admin First-Run / Environment Passcode
ADMIN_BOOTSTRAP_PASSCODE=""

# Primary Auth: SMTP Email OTP (Configure here or via Admin Panel)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="no-reply@apimuzatalk.rrgindustry.com"
SMTP_FROM_NAME="MuzTalk"

# Optional SMS Provider (Twilio - disabled by default, configurable in Admin Panel)
SMS_PROVIDER_NAME="twilio"
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_SENDER_ID=""

# Firebase (FCM Push Notifications - matches google-services.json muztalk-41f2a)
FIREBASE_PROJECT_ID="muztalk-41f2a"
FIREBASE_STORAGE_BUCKET="muztalk-41f2a.firebasestorage.app"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Or point to your private service-account JSON file outside public_html:
GOOGLE_APPLICATION_CREDENTIALS=""

# Storage Mode (All files stored AES-256-GCM encrypted in user's mobile MuzTalk folder)
STORAGE_MODE="mobile_encrypted_vault"

# WebRTC STUN / TURN (Coturn)
STUN_SERVER_URL="stun:stun.l.google.com:19302"
TURN_SERVER_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# LiveKit SFU (Scalable Group Audio/Video Calls)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

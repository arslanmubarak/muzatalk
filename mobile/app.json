{
  "expo": {
    "name": "MuzTalk",
    "slug": "muztalk",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "muztalk",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/muztalk-splash.png",
      "backgroundColor": "#101C35",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.muztech.muztalk",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/muztalk-adaptive-foreground.png",
        "backgroundColor": "#101C35"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CONTACTS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.INTERNET"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "muztalk.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "MuzTalk accesses your photos so you can share images and status updates.",
          "cameraPermission": "MuzTalk uses your camera for video calls and photo capture."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "MuzTalk uses your microphone for voice notes and audio/video calls."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "icon": "./assets/muztalk-icon.png"
  }
}
